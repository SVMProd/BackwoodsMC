<script>
(function () {
  var order = [
    ["accueil", "Accueil"], ["histoire", "Histoire"], ["chapters", "Chapters"],
    ["objectifs", "Objectifs"], ["patchs", "Patchs"], ["membres", "Membres"], ["background", "Background"],
    ["experiences", "Expériences RP"], ["motivations", "Motivations"]
  ];
  var ids = order.map(function (p) { return p[0]; });
  var pages = {};
  ids.forEach(function (id) { pages[id] = document.getElementById("p-" + id); });
  var pager = document.getElementById("pager");
  var navLinks = document.querySelectorAll(".nav a");

  function link(i, cls, label) {
    return '<a class="' + cls + '" href="#' + ids[i] + '" data-go="' + ids[i] + '"><span>' + label + '</span><b>' + order[i][1] + '</b></a>';
  }

  function show(id) {
    if (ids.indexOf(id) < 0) { id = "accueil"; }
    ids.forEach(function (k) { pages[k].hidden = (k !== id); });
    navLinks.forEach(function (a) {
      if (a.getAttribute("data-go") === id) { a.setAttribute("aria-current", "page"); }
      else { a.removeAttribute("aria-current"); }
    });
    var i = ids.indexOf(id), html = "";
    if (i > 0) { html += link(i - 1, "prev", "Page précédente"); }
    if (i < ids.length - 1) { html += link(i + 1, "next", "Page suivante"); }
    pager.innerHTML = html;
    var active = document.querySelector('.nav a[aria-current="page"]');
    if (active && active.scrollIntoView) {
      try { active.scrollIntoView({ block: "nearest", inline: "center" }); } catch (e) {}
    }
  }

  document.addEventListener("click", function (ev) {
    var a = ev.target.closest ? ev.target.closest("[data-go]") : null;
    if (!a) { return; }
    ev.preventDefault();
    var id = a.getAttribute("data-go");
    show(id);
    try { history.replaceState(null, "", "#" + id); } catch (e) {}
    window.scrollTo(0, 0);
  });

  window.addEventListener("hashchange", function () {
    show(location.hash.replace("#", ""));
    window.scrollTo(0, 0);
  });

  function initDocs() {
    document.querySelectorAll(".doc").forEach(function (a) {
      var href = (a.getAttribute("href") || "").trim();
      if (!href) {
        a.classList.add("is-empty");
        a.removeAttribute("href");
        a.setAttribute("aria-disabled", "true");
        a.innerHTML = "<span>Lien Google Doc à venir</span>";
      } else {
        a.classList.remove("is-empty");
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.innerHTML = "<span>Ouvrir le Google Doc</span><span aria-hidden=\"true\">↗</span>";
      }
    });
  }
  initDocs();

  show(location.hash.replace("#", ""));
})();
</script>

